#!/command/with-contenv sh
# shellcheck shell=sh
# Web-surface service. Always declared so s6 has a supervised slot; if
# neither HERMES_DASHBOARD nor HERMES_WEBAPP is truthy the run script exits
# cleanly and the companion finish script returns 125 (s6's "permanent
# failure, do not restart" marker), so s6-svstat reports the slot as down.
# See also docker/s6-rc.d/dashboard/finish.
#
# One slot, two surfaces. `dashboard` and `webapp` are the same hardened
# server on the same port — webapp only swaps the bundle it serves for the
# Desktop workspace. Running them as two supervised services would just be
# two processes fighting over 9119, so HERMES_WEBAPP picks which surface
# this slot starts.

truthy() {
    case "${1:-}" in
        1|true|TRUE|True|yes|YES|Yes) return 0 ;;
        *) return 1 ;;
    esac
}

if truthy "${HERMES_DASHBOARD:-}" || truthy "${HERMES_WEBAPP:-}"; then
    :
else
    # Exit 0; the finish script will exit 125 → s6-supervise won't
    # restart us and the slot reports down. Using a clean exit
    # (rather than `exec sleep infinity`) means s6-svstat reflects
    # reality: when neither var is set, the service is NOT running,
    # just supervised-with-permanent-failure. See PR #30136 review
    # item I3.
    exit 0
fi

# with-contenv repopulates HOME from /init as /root. Reset it before
# dropping privileges so HOME-anchored state lands under /opt/data.
export HOME=/opt/data

cd /opt/data
# shellcheck disable=SC1091
. /opt/hermes/.venv/bin/activate

dash_host="${HERMES_DASHBOARD_HOST:-0.0.0.0}"
dash_port="${HERMES_DASHBOARD_PORT:-9119}"

# The auth gate engages automatically on non-loopback binds and REQUIRES a
# DashboardAuthProvider to be registered, else start_server fails closed. It
# guards both surfaces — `webapp` hands off to the same start_server. Two
# zero-infra ways to satisfy it in a container:
#   • Password: set HERMES_DASHBOARD_BASIC_AUTH_USERNAME + _PASSWORD (bundled
#     dashboard_auth/basic provider — no external IDP).
#   • OAuth:    set HERMES_DASHBOARD_OAUTH_CLIENT_ID (bundled nous provider).
#
# HERMES_DASHBOARD_INSECURE no longer disables the gate (June 2026 hardening:
# unauthenticated public dashboards were the entry point for the MCP-config
# persistence campaign). It is accepted but ignored; warn if set so operators
# migrate to a real provider.
case "${HERMES_DASHBOARD_INSECURE:-}" in
    1|true|TRUE|True|yes|YES|Yes)
        echo "[dashboard] HERMES_DASHBOARD_INSECURE no longer disables the auth gate." >&2
        echo "[dashboard] A non-loopback dashboard requires an auth provider:" >&2
        echo "[dashboard]   set HERMES_DASHBOARD_BASIC_AUTH_USERNAME + _PASSWORD (password)" >&2
        echo "[dashboard]   or HERMES_DASHBOARD_OAUTH_CLIENT_ID (OAuth)." >&2
        ;;
esac

if truthy "${HERMES_WEBAPP:-}"; then
    # The renderer is baked at image build time (see the webapp_build stage in
    # the Dockerfile) and /opt/hermes is read-only to the hermes user, so name
    # the prebuilt bundle and never let the surface reach for npm — it could
    # not even take its build lock here. --skip-build is belt-and-braces: it
    # keeps the failure clean if the bundle ever goes missing.
    HERMES_WEBAPP_DIST=/opt/hermes/apps/desktop/dist-webapp
    export HERMES_WEBAPP_DIST
    set -- webapp --host "$dash_host" --port "$dash_port" --no-open --skip-build
else
    set -- dashboard --host "$dash_host" --port "$dash_port" --no-open
fi

# Skip the drop when already non-root.
[ "$(id -u)" = 0 ] || exec hermes "$@"
exec s6-setuidgid hermes hermes "$@"
