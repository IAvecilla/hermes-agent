#!/command/with-contenv sh
# shellcheck shell=sh
# Dashboard finish script. Companion to ./run.
#
# When neither HERMES_DASHBOARD nor HERMES_WEBAPP is set (or both are
# falsy), ./run exits 0 immediately. Without this finish script,
# s6-supervise would just restart the run script in a tight loop. By
# exiting 125 here, we tell s6-supervise "this service has permanently
# failed; do not restart" — equivalent to `s6-svc -O`. The supervise slot
# reports as down, matching reality (no web surface is running).
#
# When the slot IS enabled and the run script later exits or is killed, we
# want s6-supervise to restart it (the whole point of supervised
# lifecycle). So we exit non-125 in that case.
#
# The enable test must stay identical to ./run's, or the slot flaps: run
# exits 0 and finish asks for a restart, forever.

# Arguments passed to a finish script: $1=run-exit-code, $2=signal-num,
# $3=service-dir-name, $4=run-pgid. See servicedir(7).

truthy() {
    case "${1:-}" in
        1|true|TRUE|True|yes|YES|Yes) return 0 ;;
        *) return 1 ;;
    esac
}

if truthy "${HERMES_DASHBOARD:-}" || truthy "${HERMES_WEBAPP:-}"; then
    # A web surface was enabled — let s6-supervise restart on crash by
    # exiting non-125. (Pass-through any sensible default.)
    exit 0
fi

# Disabled — permanent-failure marker so s6-supervise leaves the slot in
# 'down' state and s6-svstat reflects that.
exit 125