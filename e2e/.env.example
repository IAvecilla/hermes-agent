# =============================================================================
# Hermes E2E Test Suite — Required Credentials
# =============================================================================
# Copy this to .env and fill in values. See README.md for how to obtain each.

# ── Hermes Gateway ───────────────────────────────────────────────────────────
# Path to the hermes repo root (defaults to parent directory)
HERMES_REPO_DIR=../

# LLM provider for hermes (needed so the bot can actually respond)
OPENROUTER_API_KEY=

# ── Telegram ─────────────────────────────────────────────────────────────────
# Bot token for the Hermes bot (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Telethon credentials for the test user (from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Phone number for the test user account (with country code, e.g. +1234567890)
TELEGRAM_TEST_PHONE=

# Session string (auto-generated after first login, avoids re-auth)
TELEGRAM_TEST_SESSION=

# ── Discord ──────────────────────────────────────────────────────────────────
# Bot token for the Hermes bot (from Discord Developer Portal)
DISCORD_BOT_TOKEN=

# Bot token for the test driver bot (a second bot that sends messages)
DISCORD_TEST_BOT_TOKEN=

# Test guild (server) ID — created by provision script or manually
DISCORD_TEST_GUILD_ID=

# Test channel ID within the guild — created by provision script
DISCORD_TEST_CHANNEL_ID=

# ── Slack ────────────────────────────────────────────────────────────────────
# Hermes bot tokens
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Test user OAuth token (xoxp-...) with chat:write, channels:history scopes
SLACK_TEST_USER_TOKEN=

# Test channel ID — created by provision script or manually
SLACK_TEST_CHANNEL_ID=
